<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Brechó da Veveta</title>
  <meta name="description" content="Brechó da Veveta — peças únicas, preços justos.">
  <!-- Google Font -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg: #fff9e6;            /* off-white yellow background */
      --accent: #ffd100;        /* bright yellow */
      --accent-2: #ffb400;      /* darker yellow */
      --muted: #6b6b6b;
      --card: #ffffff;
      --glass: rgba(255,255,255,0.7);
      --radius: 12px;
      --max-w: 1100px;
      font-family: "Inter", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
    }

    /* Reset & base */
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      background: linear-gradient(180deg,var(--bg), #fff);
      color:#222;
      -webkit-font-smoothing:antialiased;
      -moz-osx-font-smoothing:grayscale;
      line-height:1.45;
      padding:24px;
      display:flex;
      justify-content:center;
      font-size:16px;
    }
    .wrap{
      width:100%;
      max-width:var(--max-w);
    }

    /* NAV */
    header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      margin-bottom:18px;
    }
    .brand{
      display:flex;
      align-items:center;
      gap:12px;
      text-decoration:none;
      color:inherit;
    }
    .logo{
      width:56px;
      height:56px;
      border-radius:12px;
      background:linear-gradient(135deg,var(--accent),var(--accent-2));
      display:flex;
      align-items:center;
      justify-content:center;
      font-weight:700;
      color:#222;
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    }
    .brand h1{font-size:18px;margin:0}
    .nav{
      display:flex;
      gap:12px;
      align-items:center;
    }
    .btn{
      background:var(--accent);
      color:#111;
      padding:10px 14px;
      border-radius:10px;
      text-decoration:none;
      font-weight:600;
      box-shadow:0 6px 18px rgba(255,177,0,0.14);
    }
    .outline{
      background:transparent;
      border:2px solid rgba(0,0,0,0.06);
      padding:8px 12px;
      border-radius:10px;
      text-decoration:none;
      color:var(--muted);
      font-weight:600;
    }

    /* HERO */
    .hero{
      display:grid;
      grid-template-columns: 1fr 420px;
      gap:24px;
      align-items:center;
      margin-bottom:26px;
    }
    .hero-card{
      background: linear-gradient(180deg, var(--card), var(--glass));
      border-radius: var(--radius);
      padding:24px;
      box-shadow: 0 8px 30px rgba(15,15,15,0.06);
    }
    .eyebrow{color:var(--muted); font-weight:600; font-size:13px}
    .hero h2{margin:8px 0 12px; font-size:32px}
    .hero p{margin:0 0 18px; color: #404040}
    .search{
      display:flex;
      gap:8px;
      margin-top:6px;
    }
    .search input{
      flex:1;
      padding:12px 14px;
      border-radius:10px;
      border:1px solid rgba(0,0,0,0.06);
      font-size:15px;
    }
    .search button{padding:12px 16px; border-radius:10px; border:none; background:var(--accent-2); font-weight:700; color:#111}

    /* quick-info */
    .info-row{
      display:flex;
      gap:12px;
      margin-top:14px;
      flex-wrap:wrap;
    }
    .pill{
      background:rgba(255,209,55,0.12);
      padding:8px 10px;
      border-radius:999px;
      font-weight:600;
      color:#6b4500;
      font-size:14px;
    }

    /* Gallery */
    .gallery{
      display:grid;
      grid-template-columns: repeat(3,1fr);
      gap:14px;
      margin-bottom:26px;
    }
    .card{
      background:var(--card);
      border-radius:14px;
      overflow:hidden;
      box-shadow:0 8px 22px rgba(10,10,10,0.05);
      transition:transform .18s ease, box-shadow .18s ease;
    }
    .card:hover{transform:translateY(-6px); box-shadow:0 16px 40px rgba(12,12,12,0.09)}
    .card img{width:100%; height:220px; object-fit:cover; display:block}
    .card-body{padding:12px 14px}
    .card-title{font-weight:700;margin:0 0 6px;font-size:16px}
    .price{font-weight:700
